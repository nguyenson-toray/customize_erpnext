msgid "The typed name is different from the Employee Name."
msgstr "Họ tên nhập khác tên nhân viên trong hồ sơ."

#. source: tiqn
msgid "Zalo phone {0} already belongs to {1} - this request cannot be approved."
msgstr "SĐT Zalo {0} đã thuộc về {1} - không duyệt được yêu cầu này."

