#. source: erpnext2vi
msgid ""
"<pre><h5>Message Example</h5>\n"
"\n"
"&lt;p&gt; Thank You for being a part of {{ doc.company }}! We hope you are enjoying the service.&lt;/p&gt;\n"
"\n"
"&lt;p&gt; Please find enclosed the E Bill statement. The outstanding amount is {{ doc.grand_total }}.&lt;/p&gt;\n"
"\n"
"&lt;p&gt; We don't want you to be spending time running around in order to pay for your Bill.<br>After all, life is beautiful and the time you have in hand should be spent to enjoy it!<br>So here are our little ways to help you get more time for life! &lt;/p&gt;\n"
"\n"
"&lt;a href=\"{{ payment_url }}\"&gt; click here to pay &lt;/a&gt;\n"
"\n"
"</pre>\n"
msgstr ""
"<pre><h5>Ví dụ về tin nhắn</h5>\n"
"\n"
"&lt;p&gt; Cảm ơn bạn đã là một phần của {{ doc.company }}! Chúng tôi hy vọng bạn hài lòng với dịch vụ này.&lt;/p&gt;\n"
"\n"
"&lt;p&gt; Vui lòng xem bản kê khai Hóa đơn điện tử kèm theo. Số tiền còn nợ là {{ doc.grand_total }}.&lt;/p&gt;\n"
"\n"
"&lt;p&gt; Chúng tôi không muốn bạn mất thời gian chạy loanh quanh để trả hóa đơn.<br>Sau tất cả, cuộc sống thật tươi đẹp và bạn nên dành thời gian trong tay để tận hưởng nó!<br>Vì vậy, đây là những cách nhỏ của chúng tôi để giúp bạn có thêm thời gian cho cuộc sống! &lt;/p&gt;\n"
"\n"
"&lt;a href=\"{{ payment_url }}\"&gt; bấm vào đây để thanh toán &lt;/a&gt;\n"
"\n"
"</pre>"

#. source: erpnext2vi
msgid ""
"<pre><h5>Message Example</h5>\n"
"\n"
"&lt;p&gt;Dear {{ doc.contact_person }},&lt;/p&gt;\n"
"\n"
"&lt;p&gt;Requesting payment for {{ doc.doctype }}, {{ doc.name }} for {{ doc.grand_total }}.&lt;/p&gt;\n"
"\n"
"&lt;a href=\"{{ payment_url }}\"&gt; click here to pay &lt;/a&gt;\n"
"\n"
"</pre>\n"
msgstr ""
"<pre><h5>Ví dụ Thông điệp</h5>\n"
"\n"
"&lt;p&gt;Kính gửi {{ doc.contact_person }},&lt;/p&gt;\n"
"\n"
"&lt;p&gt;Yêu cầu thanh toán cho {{ doc.doctype }}, {{ doc.name }} cho {{ doc.grand_total }}.&lt;/p&gt;\n"
"\n"
"&lt;a href=\"{{ payment_url }}\"&gt; nhấp vào đây để thanh toán &lt;/a&gt;\n"
"\n"
"</pre>"

