#. source: erpnext2vi
msgid "The total Issue / Transfer quantity {0} in Material Request {1} cannot be greater than requested quantity {2} for Item {3}"
msgstr "Tổng số lượng Xuất / Chuyển {0} trong Yêu cầu vật tư {1} không thể lớn hơn số lượng yêu cầu {2} cho Mặt hàng {3}"

