<mxfile host="app.diagrams.net" type="device" version="24.7.17">
  <diagram id="hrms-v16" name="HRMS v16">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="lg_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c7cfdb;strokeWidth=1.5;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1048" y="930" width="586" height="268" as="geometry" /></mxCell><mxCell id="lg_head" value="Reading the arrows" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#23262b;" vertex="1" parent="1"><mxGeometry x="1066" y="942" width="550" height="22" as="geometry" /></mxCell><mxCell id="lg_l0" value="" style="endArrow=none;html=1;strokeColor=#7d879a;endArrow=blockThin;endFill=1;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="1066" y="998" width="56" height="0" as="geometry" /></mxCell><mxCell id="lg_t0" value="&lt;b&gt;Grey solid arrow &amp;#8212; Creates the next document&lt;/b&gt;&lt;br&gt;Press Create on the first document and HRMS opens the next one, already filled in. The two documents stay linked, so quantities and amounts are carried over and tracked." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5b6675;" vertex="1" parent="1"><mxGeometry x="1134" y="978" width="482" height="56" as="geometry" /></mxCell><mxCell id="lg_l1" value="" style="endArrow=none;html=1;strokeColor=#b6bdc8;dashed=1;endArrow=open;endFill=0;" vertex="1" parent="1"><mxGeometry x="1066" y="1060" width="56" height="0" as="geometry" /></mxCell><mxCell id="lg_t1" value="&lt;b&gt;Grey dashed arrow &amp;#8212; Supplies data only&lt;/b&gt;&lt;br&gt;The document at the tip reads master data, a rule or a plan from the one at the tail. Nothing is created and nothing is posted." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5b6675;" vertex="1" parent="1"><mxGeometry x="1134" y="1040" width="482" height="56" as="geometry" /></mxCell><mxCell id="lg_l2" value="" style="endArrow=none;html=1;strokeColor=#23478a;endArrow=blockThin;endFill=1;strokeWidth=1.8;" vertex="1" parent="1"><mxGeometry x="1066" y="1122" width="56" height="0" as="geometry" /></mxCell><mxCell id="lg_t2" value="&lt;b&gt;Blue solid arrow &amp;#8212; Posts to the General Ledger&lt;/b&gt;&lt;br&gt;Submitting the document writes its accounting entries by itself. Cancel the document and the entries are reversed." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5b6675;" vertex="1" parent="1"><mxGeometry x="1134" y="1102" width="482" height="56" as="geometry" /></mxCell><mxCell id="lg_note" value="Every arrow was checked against the HRMS v16 source code." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#8a94a3;" vertex="1" parent="1"><mxGeometry x="1066" y="1164" width="550" height="26" as="geometry" /></mxCell><mxCell id="title" value="HRMS v16 — how the HR system works" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#23262b;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="900" height="30" as="geometry" /></mxCell><mxCell id="subtitle" value="Employee is the master record every HR document points to; money ends up in the ERPNext General Ledger." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5b6675;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="900" height="20" as="geometry" /></mxCell><mxCell id="g_rec" value="Recruitment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#3b6fd4;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;arcSize=4;fontSize=15;fontStyle=1;fontColor=#23262b;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="250" height="476" as="geometry" /></mxCell><mxCell id="g_emp" value="Employee Lifecycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#