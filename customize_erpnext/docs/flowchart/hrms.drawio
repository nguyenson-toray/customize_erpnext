" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7c4dbd;strokeWidth=1.4;fontSize=13;fontColor=#23262b;arcSize=14;" vertex="1" parent="1"><mxGeometry x="1404" y="510" width="210" height="46" as="geometry" /></mxCell><mxCell id="adv" value="Employee Advance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b06a00;strokeWidth=1.4;fontSize=13;fontColor=#23262b;arcSize=14;" vertex="1" parent="1"><mxGeometry x="1740" y="150" width="210" height="46" as="geometry" /></mxCell><mxCell id="exp" value="Expense Claim" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b06a00;strokeWidth=1.4;fontSize=13;fontColor=#23262b;arcSize=14;" vertex="1" parent="1"><mxGeometry x="1740" y="240" width="210" height="46" as="geometry" /></mxCell><mxCell id="grat" value="Gratuity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b06a00;strokeWidth=1.4;fontSize=13;fontColor=#23262b;arcSize=14;" vertex="1" parent="1"><mxGeometry x="1740" y="330" width="210" height="46" as="geometry" /></mxCell><mxCell id="ac" value="Appraisal Cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2405a;strokeWidth=1.4;fontSize=13;fontColor=#23262b;arcSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="800" width="210" height="46" as="geometry" /></mxCell><mxCell id="appr" value="Appraisal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2405a;strokeWidth=1.4;fontSize=13;fontColor=#23262b;arcSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="890" width="210" height="46" as="geometry" /></mxCell><mxCell id="tp" value="Training Program" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a6d3b;strokeWidth=1.4;fontSize=13;fontColor=#23262b;arcSize=14;" vertex="1" parent="1"><mxGeometry x="396" y="800" width="210" height="46" as="geometry" /></mxCell><mxCell id="te" value="Training Event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8